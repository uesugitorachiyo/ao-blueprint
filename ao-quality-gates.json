{
  "schema_version": "ao.quality-gates.v1",
  "repository": "ao-blueprint",
  "lifecycle": "active_hosted",
  "supported_platforms": ["linux", "macos", "windows"],
  "required_tools": ["git", "go", "python3"],
  "generated_paths": ["bin/**", "target/**", "tmp/**"],
  "protected_paths": [".git/**", "docs/evidence/**"],
  "compatibility": {"minimum_consumer_version": "1.0.0", "owner": "ao-blueprint"},
  "evidence": {"public_safe": true, "local_artifact_root": "tmp/quality-gates", "maximum_result_bytes": 262144},
  "levels": {
    "commit": {"snapshot": "staged_tree", "maximum_duration_seconds": 10, "network_allowed": false, "mutates_source": false, "steps": [
      {"id": "staged-diff-check", "argv": ["git", "diff", "--cached", "--check"], "timeout_seconds": 10, "path_triggers": ["**"]}
    ]},
    "push": {"snapshot": "outgoing_commits", "maximum_duration_seconds": 120, "network_allowed": false, "mutates_source": false, "steps": [
      {"id": "blueprint-package-tests", "argv": ["go", "test", "./internal/blueprint", "./internal/cli", "-count=1"], "timeout_seconds": 110, "path_triggers": ["**"]}
    ]},
    "full": {"snapshot": "source_head", "maximum_duration_seconds": 1800, "network_allowed": false, "mutates_source": false, "steps": [
      {"id": "production-readiness", "argv": ["./scripts/production-readiness.sh"], "timeout_seconds": 1800, "path_triggers": ["**"]}
    ]}
  }
}
